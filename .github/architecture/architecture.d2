# cdk-lambda-web のアーキテクチャ図
# __MONO__ は単色ロゴの色。render.py がライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py .github/architecture/architecture.d2
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
}

dev: 開発者 {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F005-programmer.svg
}

user: 利用者 {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

local: 手元 {
  class: zone
  icon: https://icons.terrastruct.com/tech%2Flaptop.svg

  app: "CDK アプリ\nnew WebFunction(...)" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FDeveloper%20Tools%2FAWS-Cloud-Development-Kit.svg
  }
}

aws: "AWS Cloud (CloudFormation スタック)" {
  class: zone
  icon: https://icons.terrastruct.com/aws%2F_Group%20Icons%2FAWS-Cloud_light-bg.svg

  upload: "BucketDeployment\nfromAsset の zip を置く" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FManagement%20&%20Governance%2FAWS-CloudFormation.svg
  }

  bucket: "共有コードバケット\nバージョニング付き S3" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
  }

  fn: "WebFunction\nfunction と revision" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Lambda.svg
  }

  role: "実行ロール\nlambda.amazonaws.com" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FSecurity%2C%20Identity%2C%20&%20Compliance%2FAWS-Identify-and-Access-Management_IAM.svg
  }

  endpoint: "WebFunctionEndpoint\n既定は main (公開)" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FNetworking%20&%20Content%20Delivery%2FAmazon-API-Gateway.svg
  }

  logs: "CloudWatch Logs\n/aws/lambda/web/<関数名>.local" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FManagement%20&%20Governance%2FAmazon-CloudWatch.svg
  }
}

dev -> local.app: cdk deploy
local.app -> aws.upload: zip とテンプレート
aws.upload -> aws.bucket: "<関数名>/<hash>.zip"
aws.bucket -> aws.fn: そのバージョンを読む
aws.role -> aws.fn: 実行時の権限
aws.endpoint -> aws.fn: revision の重み
user -> aws.endpoint: HTTPS (URL)
aws.fn -> aws.logs: ログ {style.stroke-dash: 4}
